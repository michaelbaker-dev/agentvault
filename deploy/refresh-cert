#!/bin/sh
# Runs as root: (re)issues the Tailscale certificate for this machine and makes
# it readable only by the agentvault service user. The server reloads it every 6h.
set -eu
HOST=$(sed -n 's/^hostname *= *"\(.*\)"/\1/p' /etc/agentvault/config.toml)
DIR=/var/lib/agentvault/tls
install -d -m 0700 -o agentvault -g agentvault "$DIR"
tailscale cert --cert-file "$DIR/cert.pem" --key-file "$DIR/key.pem" "$HOST"
chown agentvault:agentvault "$DIR/cert.pem" "$DIR/key.pem"
chmod 0600 "$DIR/key.pem"
