[Unit]
Description=AgentVault: secrets vault for the tailnet
Documentation=file:///opt/agentvault/README.md
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=agentvault
Group=agentvault
# Issue/refresh the Tailscale HTTPS certificate as root, then hand it to the agentvault user.
ExecStartPre=+/usr/local/lib/agentvault/refresh-cert
ExecStart=/usr/local/bin/agentvault serve -c /etc/agentvault/config.toml
# The tailnet IP may not exist yet right after boot; retry until it does.
Restart=on-failure
RestartSec=5
# Automatic unlock at boot: `sudo /usr/local/lib/agentvault/auto-unlock` stores the
# passphrase as an encrypted credential and uncomments the next line.
#LoadCredentialEncrypted=passphrase:/etc/agentvault/passphrase.cred

# Bind to 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StateDirectory=agentvault
StateDirectoryMode=0700
UMask=0077
RemoveIPC=yes
LimitCORE=0

[Install]
WantedBy=multi-user.target
